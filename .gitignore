# ==============================================================================
# ZyvenPress Enterprise .gitignore
# Prevents accidental commits of credentials, build artifacts, and dumps
# ==============================================================================

# 1. Critical Secrets & Environment Files
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.p8
*.p12
*service-account*.json
google-service-account.json
settings.json
!settings.example.json

# 2. Scratchpad & Deployment Scripts
scratch/
tools/gh.exe
tools/gh.zip

# 3. Android & Binary Artifacts
*.apk
*.aab
zyvenpress_speed_fix.zip
android_app/app/build/
android_app/.gradle/
android_app/local.properties
.gradle/
build/
*.zip
*.tar
*.gz
*.rar
*.7z

# 4. Performance & Audit Dumps
lighthouse_*.json
pagespeed*.json

# 5. OS & IDE Metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.bak
*~

# 6. Python & Node Artifacts
__pycache__/
*.py[cod]
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 7. WordPress / PHP runtime & uploads (if web server synced)
wp-content/uploads/
wp-config.php
